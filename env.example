# ================================
# MongoDB Configuration
# ================================
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=arffy_AIbot_engine

# ================================
# LLM Configuration
# ================================
# Primary path is litellm (DB-driven cloud gateway). Manage providers at
# runtime via /api/llm-providers (no redeploy): provider | base_url | model
# name | api key. Swap between free providers (Gemini, Groq, OpenRouter
# :free, GitHub Models) or paid (OpenAI/custom) by config only.
#   litellm    -> DB collection llm_providers (default) + env fallback + keyword fallback
#   keyword    -> zero-dep lexical router (offline dev/tests)
#   openai     -> legacy single-provider (OPENAI_API_KEY)
LLM_PROVIDER=litellm
LITELLM_TIMEOUT_SECONDS=60
LITELLM_NUM_FALLBACKS=3
LITELLM_CACHE_TTL_SECONDS=10
# Dedicated encryption secret for DB-stored provider keys (falls back to JWT_SECRET_KEY).
# LLM_KEY_ENCRYPTION_KEY=change-me-to-32-plus-chars

# --- Cloud keys (optional bootstrap; preferred path is DB via API) ---
# Get keys: Gemini https://aistudio.google.com/app/apikey
#           Groq https://console.groq.com/keys
#           OpenRouter https://openrouter.ai/keys
#           GitHub Models https://github.com/settings/tokens (models.github.ai)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=
# OPENAI_API_KEY=sk-your-api-key-here
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=

# ================================
# Server Configuration
# ================================
HOST=0.0.0.0
PORT=8000
RELEASE_VERSION=local
AUTH_ENABLED=false
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ALERT_LATENCY_MS_THRESHOLD=2500
ALERT_ERROR_RATE_THRESHOLD=15

# ================================
# Redis Orchestration
# ================================
# Required when ENVIRONMENT=production or staging
REDIS_URL=redis://localhost:6379/0

# ================================
# Multi-runtime tool execution
# ================================
# JS warm pool size (started with API)
NODE_RUNTIME_POOL_SIZE=2
# Python lazy pool max workers (starts at 0, scales on demand)
PYTHON_RUNTIME_POOL_SIZE=2
# Idle TTL before Python pool scales back to zero
RUNTIME_IDLE_TTL_SECONDS=300
# Chat history soft limit before conversation rotation
CONVERSATION_MESSAGE_LIMIT=60
# Expose tool env vars to JS sandbox as process.env.KEY by setting TOOL_ENV_KEY=value

# ================================
# External API Keys (Optional - for your nodes)
# ================================
# Weather API
# OPENWEATHER_API_KEY=your_key_here

# Payment Processing
# STRIPE_SECRET_KEY=sk_test_your_key_here
# STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# SMS/Phone
# TWILIO_ACCOUNT_SID=your_sid_here
# TWILIO_AUTH_TOKEN=your_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# Email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Other Services
# GOOGLE_MAPS_API_KEY=your_key_here
# AWS_ACCESS_KEY_ID=your_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_here

# ================================
# Development vs Production
# ================================
ENVIRONMENT=development
# ENVIRONMENT=production

# ================================
# CORS Configuration (Optional)
# ================================
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ================================
# Logging (Optional)
# ================================
# LOG_LEVEL=INFO
# LOG_FILE=app.log
